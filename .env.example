# Token Twojego bota Telegram od @BotFather
TELEGRAM_BOT_TOKEN=tutaj_wklej_token_bota

# ID czatu lub kanału, na który mają przychodzić powiadomienia
# (napisz /chatid do bota, aby poznać swoje prywatne ID)
# Jeśli to kanał publiczny: @nazwa_kanalu, jeśli prywatny: -100xxxxxxxxxx
TELEGRAM_CHAT_ID=tutaj_wklej_chat_id

# Częstotliwość sprawdzania nowości na exsite.pl (w minutach, domyślnie 5)
CHECK_INTERVAL_MINUTES=5
